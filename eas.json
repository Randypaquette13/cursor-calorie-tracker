{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "STRAVA_CALLBACK_DOMAIN": "cursor-calorie-tracker-production.up.railway.app"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "STRAVA_CALLBACK_DOMAIN": "cursor-calorie-tracker-production.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "STRAVA_CALLBACK_DOMAIN": "cursor-calorie-tracker-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
